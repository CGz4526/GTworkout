server {
    listen 80;
    server_name ${WORKOUT_DOMAIN};
    location = /healthz { access_log off; return 200 "ok"; }
    location / { return 301 https://${WORKOUT_DOMAIN}$request_uri; }
}

server {
    listen 443 ssl;
    server_name ${WORKOUT_DOMAIN};
    if ($host != ${WORKOUT_DOMAIN}) { return 444; }
    ssl_certificate /etc/workout/tls/fullchain.pem;
    ssl_certificate_key /etc/workout/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    ssl_session_timeout 10m;
    root /usr/share/nginx/html;
    index index.html;
    client_max_body_size 21m;
    resolver 127.0.0.11 valid=10s;
    server_tokens off;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript image/svg+xml;
    add_header X-Content-Type-Options nosniff always;

    location /api/ {
        set $backend http://server:8080;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ /\. { return 404; }
    location /actuator { return 404; }
    location = /healthz { access_log off; return 200 "ok"; }
    location = /sw.js { add_header Cache-Control "no-cache"; }
    location = /index.html { add_header Cache-Control "no-cache"; }
    location = /manifest.webmanifest { add_header Cache-Control "no-cache"; }
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location / { try_files $uri $uri/ /index.html; }
}
